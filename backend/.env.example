# backend/.env — used by the backend service.
#
# `scripts/init-dev-secrets.sh` (run automatically by scripts/dev-up.sh)
# bootstraps this file by copying .env.example, then fills in JWT_SECRET
# and TURN_SECRET with fresh random values. Anything you set explicitly
# here is left alone.
#
# Most values have sensible dev defaults in code, so leaving an entry
# empty is fine for local development.


# ─── Server ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development


# ─── Database ─────────────────────────────────────────────────────
# Dev default in code: postgresql://localhost:5432/tortok
# Prod: must be set explicitly (server refuses to start without it).
DATABASE_URL=


# ─── Authentication ───────────────────────────────────────────────
# JWT_SECRET is mandatory — the server refuses to start without it.
# Auto-generated by scripts/init-dev-secrets.sh on first run; rotate
# manually with: `openssl rand -hex 64`.
JWT_SECRET=
JWT_EXPIRES_IN=7d


# ─── Instance ─────────────────────────────────────────────────────
# Dev defaults in code: 'localhost' / 'TorTok Instance'.
INSTANCE_DOMAIN=localhost:8080
INSTANCE_NAME=TorTok Local


# ─── CORS ─────────────────────────────────────────────────────────
# If unset or '*', all origins are allowed (dev-friendly default).
ALLOWED_ORIGINS=


# ─── Content origin (BEP-19 webseed URL baked into magnets) ───────
# Dev default in code: http://localhost:8090 (test-content/seeder.mjs).
# Prod default in code: the public R2 bucket URL.
CONTENT_ORIGIN_URL=


# ─── coturn / TURN credentials ────────────────────────────────────
# Shared secret with coturn (coturn/entrypoint.sh reads the same var).
# Auto-generated by scripts/init-dev-secrets.sh; if missing, the backend
# falls back to STUN-only — no TURN relay for symmetric-NAT users.
TURN_SECRET=


# ─── Bluesky bridge — Jetstream subscriber (ADR-010 + ADR-010-A) ──
# Phase 3 Unit 2.5 — bridged Bluesky video filter (ADR-010 + ADR-010-A).
# Posts with aspectRatio.height / aspectRatio.width below this value
# are rejected at firehose-index time. Default 1.0 (portrait + square
# only, ~54% of Bluesky video posts per the 2026-05-02 sampler run).
# Tune via env without redeploy.
BSKY_ASPECT_MIN=1.0


# ─── Bluesky bridge — engagement poller (ADR-010 + ADR-010-A) ─────
# Phase 3 Unit 2.5 — engagement-based promotion thresholds
# (ADR-010-A Decision 4'). A bridged post is promoted from
# `pending` to `mirrored` when ANY of these is true.
# Tune in week 1 against real volume.
BSKY_MIN_LIKES=50
BSKY_MIN_REPOSTS=10
BSKY_MIN_FOLLOWERS=5000

# Bridged posts that haven't qualified after this many days are
# soft-deleted (mirror_state = 'declined'). Re-bridging via a
# fresh firehose insert is allowed (ON CONFLICT DO NOTHING), so
# decline is non-final.
BSKY_DECLINE_AFTER_DAYS=7

# Engagement poll cadence in seconds. Don't go below ~60s in dev
# (public AppView rate-limits unauthenticated callers). Default
# 1800 (30 min) per ADR-010-A.
BSKY_POLL_INTERVAL_SEC=1800


# Phase 3 Unit 2.5 — mirror pipeline (ADR-010-A Decision 4').
# Mirror tick: how often to scan for newly-promoted rows that
# need their bytes copied to R2. Set short in dev to make
# pipeline timing observable.
BSKY_MIRROR_INTERVAL_SEC=60

# How many rows to mirror per tick. v1 default 1 (sequential
# mirror is bandwidth-bound; concurrent gives marginal speed-up
# at higher infra cost). Tune against observed throughput.
BSKY_MIRROR_BATCH=1

# Storage decay: drop mirrors not played for this many days.
# Bytes are deleted from R2 and row transitions to `expired`.
# (Re-mirror on next play is slice 4's responsibility.)
BSKY_DECAY_DAYS=30

# Decay scan cadence (seconds). Default hourly is fine for v1
# scale; revisit if storage or query cost trends up.
BSKY_DECAY_INTERVAL_SEC=3600

# Phase 3 Unit 2.5 — mirror pipeline ffmpeg invocation. The mirror
# remuxes Bluesky's HLS into a single-file MP4 so the resulting
# torrent matches the native single-file pipeline (multi-file
# webseed on Hermes is unreliable; HLS adds nothing for ≤60s
# vertical-feed video). Default 'ffmpeg' assumes the binary is on
# PATH; override with a full path on systems where it isn't.
BSKY_FFMPEG_PATH=ffmpeg

# Torrent piece size in bytes. Smaller pieces = faster
# first-piece-via-webseed (the dominant cold-start cost for a
# brand-new swarm) at the cost of slightly larger .torrent
# metadata. 16384 (16KB) is the BitTorrent minimum and the
# v1 default — first-piece fetch ~100ms over a typical webseed.
BSKY_PIECE_LENGTH=16384


# ─── Cloudflare R2 (S3-compatible API) ────────────────────────────
# Required for the Phase 3 Unit 2.5 mirror pipeline (slice 3,
# bskyMirror.ts). Same vars as the root .env Cloudflare section
# (one Account ID covers all Cloudflare products). The simplest way
# to populate these is:
#   grep -E '^(CLOUDFLARE_ACCOUNT_ID|R2_)' ../.env >> backend/.env
# (run once from the backend/ dir; copies values from root .env
# without echoing them).
#
# Without these set, the bridge mirror pipeline logs
# "R2 client not configured" and bridged_posts rows stay
# `mirrored AND r2_path IS NULL` forever — they won't appear in
# the feed (slice 4 filters on r2_path IS NOT NULL).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tortok-content
R2_ENDPOINT=
