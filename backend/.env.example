# backend/.env — used by the backend service.
#
# `scripts/init-dev-secrets.sh` (run automatically by scripts/dev-up.sh)
# bootstraps this file by copying .env.example, then fills in TURN_SECRET
# with a fresh random value. Anything you set explicitly
# here is left alone.
#
# Most values have sensible dev defaults in code, so leaving an entry
# empty is fine for local development.


# ─── Server ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development


# ─── Database ─────────────────────────────────────────────────────
# Dev default in code: postgresql://localhost:5432/tortok
# Prod: must be set explicitly (server refuses to start without it).
DATABASE_URL=


# ─── Instance ─────────────────────────────────────────────────────
# Reported by /health. Dev default in code: 'localhost'.
INSTANCE_DOMAIN=localhost:8080


# ─── CORS ─────────────────────────────────────────────────────────
# If unset or '*', all origins are allowed (dev-friendly default).
ALLOWED_ORIGINS=


# ─── Extra trackers on every feed item (comma-separated) ──────────
# Dev default in code: ws://localhost:8000 (started by scripts/dev-up.sh).
# Required in production (set in backend/fly.toml [env]). Never add public
# wss:// trackers — they leak phantom peers from earlier sessions.
TRACKER_URLS=


# ─── atproto ingest (Phase 3 Unit 2.5A) ───────────────────────────
# Jetstream subscribe endpoint, without query string. Default in code:
# wss://jetstream2.us-east.bsky.network/subscribe
JETSTREAM_URL=
# DIDs backfilled on boot even before Jetstream shows them posting
# (comma-separated). The dev account is did:plc:teqobv6pqer5nw7roqrgi55v.
INGEST_SEED_DIDS=
# Where did:plc documents come from. Default in code: https://plc.directory
# (the e2e stack points it at its own PLC).
PLC_DIRECTORY_URL=


# ─── Bluesky bridge (Phase 3 Unit 2.5D, Decision 0023) ────────────
# Run the bridge's firehose and engagement poller: true or false. Default
# false; it indexes live Bluesky into this database.
# BRIDGE_ENABLED=false
# Uncomment to override; an empty value is an error, not the default.
# Labels that keep a bridged post out (comma-separated). Default in code:
# BRIDGE_NSFW_LABELS=porn,sexual,nudity,graphic-media,gore,!hide,!takedown
# Narrowest bridged video, as height/width. Default 1 (square or portrait).
# BRIDGE_ASPECT_MIN=1
# Bluesky AppView the engagement poller reads. Default in code:
# BRIDGE_APPVIEW_URL=https://public.api.bsky.app
# A bridged post reaches the feed at this many likes or reposts, or an
# author with this many followers, within BRIDGE_QUALIFY_DAYS of being indexed.
# BRIDGE_MIN_LIKES=50
# BRIDGE_MIN_REPOSTS=10
# BRIDGE_MIN_FOLLOWERS=5000
# BRIDGE_QUALIFY_DAYS=7
# How long a qualified bridged post is kept. It is re-checked at least daily
# until then, and deleted after (Decision 0024).
# BRIDGE_RECHECK_DAYS=30
# Where bridged videos' playlists and thumbnails come from. Default in code:
# BRIDGE_VIDEO_BASE=https://video.bsky.app/watch


# ─── Feed (Phase 3 Unit 2.5B) ─────────────────────────────────────
# Origin of the feed's blob URLs (posters, avatars, .torrent files). Unset,
# they use the request's own host; set it behind a TLS-terminating proxy.
PUBLIC_BASE_URL=


# ─── coturn / TURN credentials ────────────────────────────────────
# Shared secret with coturn (coturn/entrypoint.sh reads the same var).
# Auto-generated by scripts/init-dev-secrets.sh; if missing, the backend
# falls back to STUN-only — no TURN relay for symmetric-NAT users.
TURN_SECRET=
