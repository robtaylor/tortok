# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tortok

# Authentication
# JWT_SECRET is mandatory — the server refuses to start without it.
# Generate a real one with e.g. `openssl rand -hex 64`.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Instance
INSTANCE_DOMAIN=localhost:8080
INSTANCE_NAME=TorTok Local

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://tortok.app
