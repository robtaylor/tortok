# Top-level .env — used by scripts at the repo root.
#
# Other env files (each with their own examples / docs):
#   backend/.env       — backend service (see backend/.env.example)
#   tortok/.env.local  — Expo client (EXPO_PUBLIC_API_URL, EXPO_PUBLIC_USE_P2P)
#
# Copy this file to .env and fill in real values. .env is gitignored.


# ─── Bluesky test account ─────────────────────────────────────────
# Required for `npm run smoke:atproto` (Phase 3 Unit 1).
# Use a burn account; never your real Bluesky handle.

# Create the account at https://bsky.app, then put the handle here:
BSKY_TEST_HANDLE=

# Generate an app password at:
#   https://bsky.app/settings/app-passwords  →  "Add App Password"
# Cloudflare-style xxxx-xxxx-xxxx-xxxx; shown only once.
BSKY_TEST_APP_PASSWORD=


# ─── Cloudflare R2 (S3-compatible API) ────────────────────────────
# Not consumed by code yet — will be wired up in Phase 0b when the
# seeder is extracted. Document the values here so a developer has
# one place to track them. The wrangler CLI uses OAuth (`wrangler
# login`) and does NOT need these.

# Visible in the URL of any page in https://dash.cloudflare.com.
R2_ACCOUNT_ID=

# Generate at:
#   https://dash.cloudflare.com/<R2_ACCOUNT_ID>/r2/api-tokens
#   → "Create API token" (or "Roll" to rotate the secret on an
#      existing token without changing the access-key-id).
# The secret is shown ONCE at creation; Cloudflare does not retain it.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Existing bucket — confirm via `npx wrangler r2 bucket list`.
R2_BUCKET=tortok-content

# Derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=


# ─── Optional overrides for scripts/atproto-smoke-test.mjs ────────
# BSKY_SERVICE_URL=https://bsky.social
# CLIP=bbb-01
