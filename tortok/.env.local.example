# tortok/.env.local — used by the Expo client.
#
# Both vars are optional in dev — the client auto-detects sensible
# values. Set them only when you need to override.
#
# Copy this file to .env.local if you want to set anything; it's
# gitignored (matches Expo's convention).


# Backend API URL the client hits.
#
# Dev (no override): the client reads Constants.expoConfig.hostUri
#   (the host Metro is reachable on) and uses port 8080. This works
#   on iOS sim, Android emu (10.0.2.2), and physical devices on the
#   same LAN — no manual IP configuration needed.
# Prod: the deployed API URL is baked at build time.
#
# Override examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8080  (custom LAN IP)
#   EXPO_PUBLIC_API_URL=https://staging.tortok.app
EXPO_PUBLIC_API_URL=


# P2P toggle. Default in code: enabled. Set to '0' to force webseed-
# only mode (useful for debugging the non-P2P fallback).
# EXPO_PUBLIC_USE_P2P=0
