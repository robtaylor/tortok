    "webtorrent": "^2.8.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/webtorrent": "^0.110.1",
    "detox": "^20.50.1",
    "jest": "~29.7.0",
    "jest-environment-node": "~29.7.0",
    "jest-util": "^29.7.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
