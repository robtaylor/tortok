{
  "name": "tortok",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "start": "expo start",
    "adb:ports": "ADB=\"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb\" && \"$ADB\" reverse tcp:8080 tcp:8080 && \"$ADB\" reverse tcp:8090 tcp:8090 && \"$ADB\" reverse --list",
    "android": "npm run adb:ports && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "e2e:build:ios": "EXPO_PUBLIC_E2E=1 EXPO_PUBLIC_API_URL=http://localhost:8080 detox build --configuration ios.release",
    "e2e:test:ios": "detox test --configuration ios.release",
    "e2e:build:android": "EXPO_PUBLIC_E2E=1 EXPO_PUBLIC_API_URL=http://localhost:8080 detox build --configuration android.release",
    "e2e:test:android": "detox test --configuration android.release",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@atproto/api": "^0.19.11",
    "@atproto/oauth-client-expo": "^0.0.10",
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.99.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "expo": "~54.0.33",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mmkv": "^3.3.3",
    "react-native-quick-crypto": "^1.0.19",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "readable-stream": "^4.7.0",
    "url": "^0.11.4",
